generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Category {
  MEDICAMENT
  VACCIN
  REACTIF
  CONSOMMABLE
  PETIT_MATERIEL
  MATERIEL_BUREAU
}

enum HospitalType {
  CENTRE_HOSPITALIER
  CENTRE_SANTE
  HOPITAL_PROVINCIAL
}

enum NoteStatus {
  BROUILLON
  VALIDE
  LIVRE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  PRINT
  LOGIN
  LOGOUT
}

// ==================== USERS ====================

model User {
  id            String    @id @default(uuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  role          String    @default("USER")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  activities    ActivityLog[]

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

// ==================== HÔPITAUX ====================

model Hospital {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  type              HospitalType
  address           String?
  phone             String?
  email             String?
  bedCapacity       Int?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  allocations       AnnualAllocation[]
  stockExits        StockExit[]
  deliveryNotes     DeliveryNote[]

  @@index([code])
  @@index([isActive])
  @@index([type])
  @@map("hospitals")
}

// ==================== PRODUITS ====================

model Product {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  category      Category
  unit          String
  packaging     String?
  price         Decimal?      @db.Decimal(10, 2)
  minStock      Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  batches       Batch[]
  stockEntries  StockEntry[]
  stockExits    StockExit[]
  kitComponents KitComponent[]

  @@index([code])
  @@index([category])
  @@index([isActive])
  @@index([name])          // For search
  @@map("products")
}

// ==================== LOTS ====================

model Batch {
  id            String        @id @default(uuid())
  batchNumber   String
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  expiryDate    DateTime
  temperature   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stockEntries  StockEntry[]
  stockExits    StockExit[]
  deliveryItems DeliveryNoteItem[]

  @@unique([batchNumber, productId])
  @@index([productId])
  @@index([expiryDate])      // CRITICAL: For expiry alerts
  @@index([quantity])        // For stock availability
  @@index([productId, expiryDate])  // Covering index for FEFO
  @@map("batches")
}

// ==================== ENTRÉES STOCK ====================

model StockEntry {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity      Int
  referenceDoc  String?
  notes         String?
  entryDate     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
  @@index([batchId])
  @@index([entryDate])       // For date range queries
  @@index([createdAt])
  @@index([referenceDoc])    // For document lookup
  @@map("stock_entries")
}

// ==================== SORTIES STOCK ====================

model StockExit {
  id             String        @id @default(uuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  hospitalId     String
  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  quantity       Int
  quarter        Int
  year           Int
  notes          String?
  exitDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deliveryNote   DeliveryNote? @relation(fields: [deliveryNoteId], references: [id])
  deliveryNoteId String?

  @@index([productId])
  @@index([hospitalId])
  @@index([batchId])
  @@index([exitDate])
  @@index([year, quarter])        // For quarterly reports
  @@index([deliveryNoteId])
  @@index([createdAt])
  @@map("stock_exits")
}

// ==================== ALLOCATION ANNUELLE ====================

model AnnualAllocation {
  id          String    @id @default(uuid())
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  category    Category
  year        Int
  budget      Decimal   @db.Decimal(12, 2)
  q1Consumed  Decimal   @default(0) @db.Decimal(12, 2)
  q2Consumed  Decimal   @default(0) @db.Decimal(12, 2)
  q3Consumed  Decimal   @default(0) @db.Decimal(12, 2)
  q4Consumed  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([hospitalId, category, year])
  @@index([hospitalId])
  @@index([year])
  @@index([year, hospitalId])
  @@index([category])
  @@map("annual_allocations")
}

// ==================== BONS DE LIVRAISON ====================

model DeliveryNote {
  id            String              @id @default(uuid())
  noteNumber    String              @unique
  hospitalId    String
  hospital      Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  quarter       Int
  year          Int
  status        NoteStatus          @default(BROUILLON)
  totalAmount   Decimal?            @db.Decimal(12, 2)
  deliveredAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         DeliveryNoteItem[]
  stockExits    StockExit[]

  @@index([noteNumber])
  @@index([hospitalId])
  @@index([year, quarter])
  @@index([status])
  @@index([createdAt])
  @@index([deliveredAt])
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id              String        @id @default(uuid())
  deliveryNoteId  String
  deliveryNote    DeliveryNote  @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())

  @@index([deliveryNoteId])
  @@index([batchId])
  @@map("delivery_note_items")
}

// ==================== KITS NAISSANCE ====================

model BirthKit {
  id            String          @id @default(uuid())
  kitNumber     String          @unique
  kitType       String          // NORMAL or EPISIOTOMIE
  isComplete    Boolean         @default(false)
  isDistributed Boolean         @default(false)
  distributedAt DateTime?
  hospitalId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  components    KitComponent[]

  @@index([kitNumber])
  @@index([isComplete])
  @@index([isDistributed])
  @@index([kitType])
  @@map("birth_kits")
}

model KitComponent {
  id          String    @id @default(uuid())
  kitId       String
  kit         BirthKit  @relation(fields: [kitId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  isPresent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kitId])
  @@index([productId])
  @@map("kit_components")
}

// ==================== LOGS ACTIVITÉ ====================

model ActivityLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      ActionType
  entityType  String      // e.g., "Product", "StockEntry", "DeliveryNote"
  entityId    String?
  description String?
  metadata    String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([entityType, createdAt])  // For entity history
  @@map("activity_logs")
}
